# Stage 1: install exactly pixi.lock's runtime environment (`prod`: no dev tools), then drop
# what is never used at run time.
Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:0.77.0-bookworm-slim
Stage: build

%files
    pyproject.toml /opt/soba_matchups/pyproject.toml
    pixi.lock /opt/soba_matchups/pixi.lock
    README.md /opt/soba_matchups/README.md
    LICENSE /opt/soba_matchups/LICENSE
    src /opt/soba_matchups/src
    examples /opt/soba_matchups/examples

%post
    set -eu
    cd /opt/soba_matchups
    pixi install --locked -e prod
    rm -rf /root/.cache
    # C headers, static libraries, docs, the test suites shipped inside packages and the
    # conda package records (keep `testing` modules: xarray imports its own at start-up).
    env=.pixi/envs/prod
    rm -rf $env/include $env/share/doc $env/share/man $env/share/info $env/conda-meta
    find $env/lib -maxdepth 1 -name '*.a' -delete
    find $env/lib/python3.12/site-packages -type d -name tests -prune -exec rm -rf {} +
    find $env -name __pycache__ -prune -exec rm -rf {} +

# Stage 2: the environment and the package source at the same paths (the package is an
# editable install pointing at src/), without pixi or its caches.
Bootstrap: docker
From: debian:bookworm-slim
Stage: final

%files from build
    /opt/soba_matchups/.pixi/envs/prod /opt/soba_matchups/.pixi/envs/prod
    /opt/soba_matchups/src /opt/soba_matchups/src
    /opt/soba_matchups/pyproject.toml /opt/soba_matchups/pyproject.toml
    /opt/soba_matchups/examples /opt/soba_matchups/examples

%environment
    export PATH=/opt/soba_matchups/.pixi/envs/prod/bin:$PATH
    export CONDA_PREFIX=/opt/soba_matchups/.pixi/envs/prod
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec soba_matchups "$@"

%test
    set -eu
    python -c 'import soba_matchups.pipeline, pyarrow.parquet, netCDF4, s1_geometry'
    soba_matchups --help

%labels
    org.soba.tool soba_matchups
    org.soba.source https://github.com/umr-lops/soba_matchups

%help
    Build from the repository root (internet access required for the packages):
        apptainer build soba_matchups.sif apptainer.def

    The environment is pixi.lock's `prod` environment, so the image holds exactly the versions
    tested in CI. Commit pixi.lock before building.

    Bind the KNMI and ESA archives read-only, and the output workspace writable:
        ESA=/legacy/project/cersat/public/cache/project/mpc-sentinel1/data/esa
        apptainer run --bind "$ESA:$ESA:ro" \
            --bind /path/to/knmi/satellite/l2b:/path/to/knmi/satellite/l2b:ro \
            --bind /path/to/work:/work soba_matchups.sif run --recipe /work/hscat.toml

    Set reference_root to the KNMI path you bound, sar_archive_root to the same ESA path,
    and output_dir to a NEW directory under /work. No API, credentials or cache.
    The ESA root must contain extracted L2/WV OCN SAFEs and their measurement NCs.
    No L1 files are used. Output items/ contains one STAC JSON per matched imagette.
